# Mythgram AI backend configuration

# Port the Express server listens on
PORT=8787

# Absolute or relative path to the agent workspace.
# Defaults to the directory where mythgram is started/running (process.cwd()).
# All file tools are sandboxed to this directory. The ".mythgram" dir is
# initialized where the workspace is set.
WORKSPACE_ROOT=

# Maximum ReAct iterations per turn
MAX_ITERATIONS=1000

# Comma separated list of allowed CORS origins, or * for all
CORS_ORIGINS=*

# Timeout (ms) for shell commands run via the shall_tool
SHELL_TIMEOUT_MS=180000

# How long submit_plan waits for a user decision before continuing autonomously (ms)
PLAN_APPROVAL_TIMEOUT_MS=60000

# How long ask_question_to_user waits for the user's answers before continuing autonomously (ms)
QUESTION_TIMEOUT_MS=180000

# Web search & fetch fallback keys (overridden per-request by frontend Settings).
# Search provider: duckduckgo (default, free, NO api key required) | tavily | exa | serpapi
SEARCH_PROVIDER=duckduckgo
# Web fetch/scrape provider: builtin (default, free, NO api key required) | firecrawl
FETCH_PROVIDER=builtin
TAVILY_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=

# Composio API key for third-party app connectors (GitHub, Slack, ...).
# The frontend Settings popup overrides this per user; this env value is the server fallback.
COMPOSIO_API_KEY=

# Text-to-speech provider keys (server fallback; the TTS panel stores a key per provider).
# OPENROUTER_API_KEY is reused from the LLM provider settings; set it here to share one key.
OPENROUTER_API_KEY=
# KittenML API key with the tts:generate permission (https://platform.kittenml.com/developers/api-keys).
KITTENML_API_KEY=

# Background memory agent schedule (system defaults; the frontend Settings can override per turn).
# The memory agent builds memory after every N completed user tasks (default 3) and stays idle
# before that. Set MEMORY_AGENT_ENABLED=false to turn it off entirely (no extra LLM tokens spent).
MEMORY_AGENT_ENABLED=true
MEMORY_AGENT_INTERVAL=3

# read_image tool model capability overrides (comma-separated model-id substrings).
# These are combined with built-in heuristics that decide whether a model accepts
# image inputs. VISION_MODEL_PATTERNS always allow image reading; TEXT_ONLY_MODEL_PATTERNS
# always block it. Unknown models are treated as vision capable by default.
VISION_MODEL_PATTERNS=
TEXT_ONLY_MODEL_PATTERNS=

# Automatic context summarization handoff (fraction 0..1, default 0.9 = 90%).
# When the main agent's context utilization reaches this threshold, it pauses,
# summarizes via a dedicated summary agent, replaces its context, and resumes.
SUMMARY_THRESHOLD=0.9

# Sliding-window context management (secondary method, fraction 0.05..0.9, default 0.3 = 30%).
# When the context window reaches 99%, the agent pauses, deletes the oldest ~30%
# tokens (chat data / reasoning / tool calls+results; system prompt, memory,
# knowledge, and latest user input are preserved), then resumes. The frontend
# Settings value wins per turn when present.
SLIDING_WINDOW_TRUNCATE_PERCENT=0.3
