# deploy/examples/.env.production
#
# Example production environment for the Mythgram backend. Copy next to the
# process working directory as `.env`, or export these in your systemd unit /
# PM2 config / container environment.
#
# Model provider credentials are configured in the web console (Settings) and
# stored in the database; the keys here are optional server-side fallbacks.

# --- Server -----------------------------------------------------------------
PORT=8787
NODE_ENV=production

# Folder the agent may read/write; .mythgram/ is created here.
WORKSPACE_ROOT=/srv/mythgram-workspace

# Fixed application data dir. Set this so moving/restarting the process from a
# different cwd never forks your chats and settings.
MYTHGRAM_DATA_DIR=/srv/mythgram-workspace/.mythgram

# Restrict to the public origin(s) of your reverse proxy — never "*" in production.
CORS_ORIGINS=https://mythgram.example.com

# --- Agent behavior ---------------------------------------------------------
MAX_ITERATIONS=1000
SHELL_TIMEOUT_MS=180000
PLAN_APPROVAL_TIMEOUT_MS=60000
QUESTION_TIMEOUT_MS=180000

# --- Web search / fetch (DuckDuckGo + builtin are keyless defaults) ---------
SEARCH_PROVIDER=duckduckgo
FETCH_PROVIDER=builtin
# TAVILY_API_KEY=
# EXA_API_KEY=
# SERPAPI_API_KEY=
# FIRECRAWL_API_KEY=

# --- Integrations (optional) ------------------------------------------------
# COMPOSIO_API_KEY=
# GITHUB_TOKEN=

# --- Memory / context -------------------------------------------------------
MEMORY_AGENT_ENABLED=true
MEMORY_AGENT_INTERVAL=3
SUMMARY_THRESHOLD=0.9
SLIDING_WINDOW_TRUNCATE_PERCENT=0.3
