# Base image for Mythgram (React/Vite frontend + TypeScript/Express backend).
# It pre-installs the npm dependencies for both packages so application builds are
# fast and reproducible. Build this image once and push it to your registry; the
# root Dockerfile consumes it through the BASE_IMAGE build argument.

FROM node:22-slim AS base

# Toolchain for native modules (e.g. better-sqlite3) when no prebuilt binary is
# available for the target platform.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Backend dependencies (mythgram): runtime deps plus tsx/typescript used to run
# and type-check the TypeScript entry point.
WORKDIR /app/mythgram
COPY mythgram/package.json mythgram/package-lock.json ./
RUN npm ci --no-audit --no-fund

# Frontend dependencies (frontend-main): includes the build-time devDependencies
# (vite, typescript) needed to produce the production bundle. .npmrc enables
# legacy peer resolution required by the current TypeScript toolchain.
WORKDIR /app/frontend-main
COPY frontend-main/package.json frontend-main/package-lock.json frontend-main/.npmrc ./
RUN npm ci --no-audit --no-fund

# The base image now holds node_modules for both packages under /app.
# User code is copied on top of it during the actual build.
WORKDIR /app
